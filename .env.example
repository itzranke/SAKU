# SAKU ENVIRONMENT CONFIGURATION

# Core App Configuration
NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:3000
# Optional: where the Next.js dev server proxies /api/proxy/* (server-side, not the browser)
# SAKU_API_INTERNAL_URL=http://localhost:4000

# Database & Storage
DATABASE_URL="postgresql://saku_admin:saku_secret_password@localhost:5432/saku_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="saku_jwt_secret_change_in_production_key_32chars"
ENCRYPTION_MASTER_KEY="saku_master_key_32_bytes_long_string!"

# Market Data API Keys
TWELVEDATA_API_KEY=""
BINANCE_API_KEY=""
